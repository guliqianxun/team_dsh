{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "react"
    ],
    "jsx": "react-jsx",
    "outDir": "./node_modules/.cache/client-test-types",
    "tsBuildInfoFile": "./node_modules/.cache/client-tests.tsbuildinfo"
  },
  "references": [
    {
      "path": "./tsconfig.client.json"
    }
  ],
  "include": [
    "tests/minimal-client*.test.ts",
    "tests/minimal-client*.test.tsx",
    "src/client/assets.d.ts",
    "tests/history-*.test.ts"
  ]
}
